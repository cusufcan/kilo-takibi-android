<?xml version="1.0" encoding="utf-8"?>
<!-- Tartı, 66 dp güvenli alanın ortasında yaklaşık 50 dp yer kaplar. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.55"
        android:scaleY="2.55"
        android:translateX="23.4"
        android:translateY="23.4">
        <path
            android:pathData="@string/seyir_scale_body_path"
            android:strokeColor="@android:color/white"
            android:strokeWidth="1.65" />
        <path
            android:pathData="@string/seyir_scale_display_path"
            android:strokeColor="@android:color/white"
            android:strokeWidth="1.65" />
        <path
            android:pathData="@string/seyir_scale_digit_path"
            android:strokeColor="@android:color/white"
            android:strokeLineCap="round"
            android:strokeWidth="1.35" />
    </group>
</vector>
